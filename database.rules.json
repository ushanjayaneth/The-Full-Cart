{
  "rules": {
    "products": {
      ".read": true,
      ".write": true,
      ".indexOn": ["category", "price", "stock"]
    },
    "settings": {
      ".read": true,
      ".write": true
    },
    "orders": {
      ".read": true,
      ".indexOn": ["orderNumber", "customer/phone", "createdAt"],
      "$orderId": {
        ".write": true,
        ".validate": "newData.hasChildren(['id', 'orderNumber', 'customer', 'items', 'total', 'status']) && newData.child('total').isNumber() && newData.child('orderNumber').isString()"
      }
    }
  }
}
